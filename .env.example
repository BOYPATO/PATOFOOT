# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) runtime & migration environment variables (auto-injected by platform)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional external live football roster APIs (strictly server-side, never exposed to client)
# API-Football v3 (https://www.api-football.com/)
API_FOOTBALL_KEY=""
# Football-Data.org v4 (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=""
# TheSportsDB API (https://www.thesportsdb.com/) — optional; defaults to public live endpoint if blank
THESPORTSDB_API_KEY=""

# Production security secret for trainer sessions (generate a long random string in production)
SESSION_SECRET=""

# Google Play Store (TWA / PWABuilder) & Apple App Store (Universal Links) verification
ANDROID_APP_PACKAGE="com.patofoot.manager2026"
ANDROID_SHA256_FINGERPRINTS=""
APPLE_TEAM_ID=""
IOS_BUNDLE_ID="com.patofoot.manager2026"

